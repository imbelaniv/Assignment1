@model WebApplication1.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h1>Event Details</h1>
<hr />

<dl class="row">
    <dt class="col-sm-3">Event Name</dt>
    <dd class="col-sm-9">@Model.EventName</dd>

    <dt class="col-sm-3">Event Date</dt>
    <dd class="col-sm-9">@Model.EventDate.ToString("dd MMM yyyy HH:mm")</dd>

    <dt class="col-sm-3">Venue</dt>
    <dd class="col-sm-9">@(Model.Venue?.VenueName ?? "Not assigned")</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
</dl>

<div class="d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.EventId" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
