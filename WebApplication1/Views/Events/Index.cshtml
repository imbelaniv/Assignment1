@model IEnumerable<WebApplication1.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Events</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add Event</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No events found. Add one to get started.</div>
}
else
{
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Event Name</th>
                <th>Event Date</th>
                <th>Venue</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ev in Model)
            {
                <tr>
                    <td>@ev.EventName</td>
                    <td>@ev.EventDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@(ev.Venue?.VenueName ?? "—")</td>
                    <td>@(ev.Description?.Length > 60 ? ev.Description[..60] + "…" : ev.Description)</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
