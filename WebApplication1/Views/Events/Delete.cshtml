@model WebApplication1.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<h1>Delete Event</h1>
<hr />

<div class="alert alert-warning">
    Are you sure you want to delete <strong>@Model.EventName</strong>?
</div>

<dl class="row">
    <dt class="col-sm-3">Event Name</dt>
    <dd class="col-sm-9">@Model.EventName</dd>

    <dt class="col-sm-3">Event Date</dt>
    <dd class="col-sm-9">@Model.EventDate.ToString("dd MMM yyyy HH:mm")</dd>

    <dt class="col-sm-3">Venue</dt>
    <dd class="col-sm-9">@(Model.Venue?.VenueName ?? "Not assigned")</dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@(Model.Description ?? "—")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="EventId" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
