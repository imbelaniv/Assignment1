@model IEnumerable<WebApplication1.Models.BookingDetailsViewModel>

@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Bookings</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Booking</a>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width:400px;">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
               placeholder="Search by Booking ID or Event Name…" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
        {
            <a asp-action="Index" class="btn btn-outline-danger">Clear</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No bookings found.</div>
}
else
{
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th>Booking ID</th>
                <th>Event</th>
                <th>Event Date</th>
                <th>Venue</th>
                <th>Location</th>
                <th>Capacity</th>
                <th>Booking Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.BookingId</td>
                    <td>@b.EventName</td>
                    <td>@b.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@b.VenueName</td>
                    <td>@b.Location</td>
                    <td>@b.Capacity</td>
                    <td>@b.BookingDate.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@b.BookingId" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a asp-action="Edit" asp-route-id="@b.BookingId" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="Delete" asp-route-id="@b.BookingId" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
